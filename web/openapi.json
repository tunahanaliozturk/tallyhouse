    }
  },
  "components": {
    "schemas": {
      "CreateProjectRequest": {
        "required": [
          "name",
          "settings"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "settings": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ProjectSettings"
              }
            ]
          }
        }
      },
      "CreateProjectResponse": {
        "required": [
          "id",
          "name",
          "writeKey",
          "readKey"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "writeKey": {
            "type": "string"
          },
          "readKey": {
            "type": "string"
          }
        }
      },
      "EventResultResponse": {
        "required": [
          "index",
          "messageId",
          "status",
          "reason"
        ],
        "type": "object",
        "properties": {
          "index": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "messageId": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": "string"
          },
          "reason": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "FieldSpec": {
        "required": [
          "type"
        ],
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/FieldType"
          },
          "required": {
            "type": "boolean",
            "default": false
          },
          "enum": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          }
        }
      },
      "FieldType": {
        "enum": [
          "string",
          "number",
          "integer",
          "boolean"
        ]
      },
      "FilterOperator": {
        "enum": [
          "eq",
          "neq",
          "in",
          "gt",
          "lt"
        ]
      },
      "FunnelQuery": {
        "required": [
          "steps",
          "from",
          "to",
          "windowSeconds"
        ],
        "type": "object",
        "properties": {
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "from": {
            "type": "string",
            "format": "date"
          },
          "to": {
            "type": "string",
            "format": "date"
          },
          "windowSeconds": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      },
      "FunnelResult": {
        "required": [
          "steps",
          "sampling"
        ],
        "type": "object",
        "properties": {
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FunnelStep"
            }
          },
          "sampling": {
            "$ref": "#/components/schemas/Sampled"
          }
        }
      },
      "FunnelStep": {
        "required": [
          "event",
          "users",
          "conversionFromPrevious",
          "conversionFromStart",
          "medianSecondsFromStart"
        ],
        "type": "object",
        "properties": {
          "event": {
            "type": "string"
          },
          "users": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "conversionFromPrevious": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "conversionFromStart": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "medianSecondsFromStart": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "IngestResponse": {
        "required": [
          "accepted",
          "duplicates",
          "sampledOut",
          "quarantined",
          "notAccepted"
        ],
        "type": "object",
        "properties": {
          "accepted": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "duplicates": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "sampledOut": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "quarantined": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "notAccepted": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventResultResponse"
            }
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ProjectSettings": {
        "required": [
          "redactProperties",
          "sampleRates"
        ],
        "type": "object",
        "properties": {
          "redactProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sampleRates": {
            "type": "object",
            "additionalProperties": {
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
              "type": [
                "number",
                "string"
              ],
              "format": "double"
            }
          }
        }
      },
      "PropertyFilter": {
        "required": [
          "property",
          "operator",
          "values"
        ],
        "type": "object",
        "properties": {
          "property": {
            "type": "string"
          },
          "operator": {
            "$ref": "#/components/schemas/FilterOperator"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "PutSchemaResponse": {
        "required": [
          "event",
          "version",
          "change"
        ],
        "type": "object",
        "properties": {
          "event": {
            "type": "string"
          },
          "version": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "change": {
            "type": "string"
          }
        }
      },
      "QuarantineItemResponse": {
        "required": [
          "id",
          "receivedAt",
          "messageId",
          "event",
          "reason",
          "payload"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "receivedAt": {
            "type": "string",
            "format": "date-time"
          },
          "messageId": {
            "type": "string"
          },
          "event": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "payload": {
            "type": "string"
          }
        }
      },
      "QuarantinePageResponse": {
        "required": [
          "items",
          "next"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuarantineItemResponse"
            }
          },
          "next": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ReplayResponse": {
        "required": [
          "quarantineId",
          "status",
          "reason"
        ],
        "type": "object",
        "properties": {
          "quarantineId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string"
          },
          "reason": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RetentionCohort": {
        "required": [
          "day",
          "users",
          "retained"
        ],
        "type": "object",
        "properties": {
          "day": {
            "type": "string",
            "format": "date"
          },
          "users": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "retained": {
            "type": "array",
